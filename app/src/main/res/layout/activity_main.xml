<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Web URL -->
    <TextView
        android:id="@+id/tvUrl"
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:text="Web Url:"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="90dp"/>

    <EditText
        android:id="@+id/etUrl"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:text="https://www.google.com"
        android:textSize="16sp"
        android:singleLine="true"
        app:layout_constraintStart_toEndOf="@id/tvUrl"
        app:layout_constraintEnd_toStartOf="@id/btnBrowse"
        app:layout_constraintTop_toTopOf="@id/tvUrl"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="8dp"/>

    <Button
        android:id="@+id/btnBrowse"
        android:layout_width="90dp"
        android:layout_height="45dp"
        android:text="Browse"
        android:textSize="13sp"
        android:padding="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvUrl"
        android:layout_marginEnd="18dp"/>


    <!-- Phone -->
    <TextView
        android:id="@+id/tvPhone"
        android:layout_width="75dp"
        android:layout_height="45dp"
        android:text="Phone No:"
        android:textSize="16sp"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/etPhone"
        android:layout_marginStart="10dp"/>

    <EditText
        android:id="@+id/etPhone"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:text="9999999999"
        android:textSize="16sp"
        android:inputType="phone"
        android:singleLine="true"
        app:layout_constraintStart_toEndOf="@id/tvPhone"
        app:layout_constraintEnd_toStartOf="@id/btnCall"
        app:layout_constraintTop_toBottomOf="@id/etUrl"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnCall"
        android:layout_width="90dp"
        android:layout_height="45dp"
        android:text="Call"
        android:textSize="13sp"
        android:padding="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/etPhone"
        android:layout_marginEnd="18dp"/>


    <!-- Call Log -->
    <TextView
        android:id="@+id/tvCallLog"
        android:layout_width="75dp"
        android:layout_height="45dp"
        android:text="Call Log:"
        android:textSize="16sp"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnCallLog"
        android:layout_marginStart="10dp"/>

    <Button
        android:id="@+id/btnCallLog"
        android:layout_width="90dp"
        android:layout_height="45dp"
        android:text="Call Log"
        android:textSize="13sp"
        android:padding="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCall"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="8dp"/>


    <!-- Gallery -->
    <TextView
        android:id="@+id/tvGallery"
        android:layout_width="75dp"
        android:layout_height="45dp"
        android:text="Gallery:"
        android:textSize="16sp"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnGallery"
        android:layout_marginStart="10dp"/>

    <Button
        android:id="@+id/btnGallery"
        android:layout_width="90dp"
        android:layout_height="45dp"
        android:text="Gallery"
        android:textSize="13sp"
        android:padding="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCallLog"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="8dp"/>


    <!-- Camera -->
    <TextView
        android:id="@+id/tvCamera"
        android:layout_width="75dp"
        android:layout_height="45dp"
        android:text="Camera:"
        android:textSize="16sp"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnCamera"
        android:layout_marginStart="10dp"/>

    <Button
        android:id="@+id/btnCamera"
        android:layout_width="90dp"
        android:layout_height="45dp"
        android:text="Camera"
        android:textSize="13sp"
        android:padding="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnGallery"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="8dp"/>


    <!-- Alarm -->
    <TextView
        android:id="@+id/tvAlarm"
        android:layout_width="75dp"
        android:layout_height="45dp"
        android:text="Alarm:"
        android:textSize="16sp"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnAlarm"
        android:layout_marginStart="10dp"/>

    <Button
        android:id="@+id/btnAlarm"
        android:layout_width="90dp"
        android:layout_height="45dp"
        android:text="Alarm"
        android:textSize="13sp"
        android:padding="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCamera"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="8dp"/>


    <!-- Login -->
    <TextView
        android:id="@+id/tvLogin"
        android:layout_width="75dp"
        android:layout_height="45dp"
        android:text="Login:"
        android:textSize="16sp"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnLogin"
        android:layout_marginStart="10dp"/>

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="90dp"
        android:layout_height="45dp"
        android:text="Login"
        android:textSize="13sp"
        android:padding="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnAlarm"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>